###############################################################################
# EduRepo – Beispiel-Konfiguration
# Kopiere diese Datei nach `.env` und passe die Werte an.
# Alle Variablen werden von docker-compose.yml automatisch eingelesen.
###############################################################################

# --- Allgemein ---
# Modus: development | production
NODE_ENV=development
# Generiere mit: openssl rand -hex 32
JWT_SECRET=please-change-me-to-a-very-long-random-string
JWT_EXPIRES_IN=7d
# Für Avatar-/OAuth-State-Tokens
APP_SECRET=please-change-me-as-well
# Öffentliche Basis-URL der Applikation (Frontend)
PUBLIC_BASE_URL=http://localhost:3000
# Interne API-URL (Backend), wie vom Frontend-Container erreichbar
API_BASE_URL=http://localhost:4000
# CORS: Erlaubte Origins (kommasepariert)
CORS_ORIGINS=http://localhost:3000

# --- Persistente Daten (Coder Workspaces) ---
# Alle Docker-Volumes (Postgres/Redis/MinIO) liegen in diesem Ordner und
# ueberleben so ein Workspace-Update. Standard (standalone): ./docker-data
# EDUREPO_DATA_DIR=/opt/coder/EduRepo

# --- Datenbank (PostgreSQL) ---
POSTGRES_USER=edurepo
POSTGRES_PASSWORD=edurepo-secret
POSTGRES_DB=edurepo
# Interner Hostname aus docker-compose
DATABASE_URL=postgresql://edurepo:edurepo-secret@postgres:5432/edurepo?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Object Storage (MinIO / S3) ---
MINIO_ROOT_USER=edurepo-minio
MINIO_ROOT_PASSWORD=edurepo-minio-secret
# Bucket für verschlüsselte Lehrmittel
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=edurepo-files
S3_ACCESS_KEY_ID=edurepo-minio
S3_SECRET_ACCESS_KEY=edurepo-minio-secret
# Flag: SSE-S3 serverseitige Verschlüsselung aktivieren
S3_USE_SSL=false
# Falls Zugriff über Browser/Public nötig (Downloads via presigned URL):
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Datei-Upload ---
# Max. Dateigrösse in Bytes (Default 100 MB)
MAX_FILE_SIZE_BYTES=104857600

# --- SMTP (E-Mail-Versand) ---
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="EduRepo <noreply@example.org>"

# --- OAuth: Google ---
# In der Google Cloud Console OAuth-Client (Web) erstellen.
# Redirect-URI = ${API_BASE_URL}/auth/google/callback  (also z. B. http://localhost:4000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth: Microsoft (Azure AD / Entra ID) ---
# App-Registrierung in Entra ID.
# Redirect-URI = ${API_BASE_URL}/auth/microsoft/callback (also z. B. http://localhost:4000/auth/microsoft/callback)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Initialer Administrator ---
# Beim ersten Start wird (falls noch vorhanden) ein Admin-Konto mit dieser E-Mail angelegt.
# Das initiale Passwort wird in den Logs ausgegeben (nur Development).
INITIAL_ADMIN_EMAIL=admin@edurepo.local